4:{"tenant":{"tenant_id":"f8483f72-1d14-49eb-a98b-e4b89d969c78","tenant_name":"Casa Padel Pineapple Park","slug":"casa-padel-pineapple-park","address":{"street":"Arnulfstraße 195","postal_code":"80335","city":"München","sub_administrative_area":"Oberbayern","administrative_area":"Bayern","country":"Deutschland","country_code":"DE","coordinate":{"lat":48.1492788,"lon":11.52342166},"timezone":"Europe/Berlin"},"images":["https://res.cloudinary.com/playtomic/image/upload/v1747733694/pro/tenants/f8483f72-1d14-49eb-a98b-e4b89d969c78/1747733693994.jpg"],"properties":{"WEBSITE_URL":"https://casapadel.de/home/casa-padel-pineapple-park","FACILITY_SNACK_BAR":"false","DETAILS_PAGE_DESCRIPTION":"Pineapple Park – mehr als nur Padel: Der Pineapple Park ist kein klassischer Padel-Club, sondern ein kreatives Zwischenkonzept: urban, unkompliziert und mit Fokus auf  Spaß, Bewegung und Community. \nInfos für Padel im Pineapple Park:\n* Schläger mieten und Bälle kaufen vor Ort am Padel Kiosk\n* 6 Meter Deckenhöhe - an manchen Stellen mehr \n* weitere Informationen auf casapadel.de\n\n\nFür gebuchte Indoor-Spielzeiten außerhalb der regulären Öffnungszeiten erfolgt der Zutritt zur Anlage über die Glastür mit der Beschilderung „Personaleingang“.Bitte folgen Sie der entsprechenden Beschilderung vor Ort – der Zugang ist dort außerhalb der regulären Öffnungszeiten möglich.\nWeitere Informationen zu unserer Anlage, den Preisen & den Parkmöglichkeiten: https://casapadel.de/home/casa-padel-pineapple-park/","FACILITY_MATERIAL_RENTING":"true","FACILITY_LOCKERS":"true","CONTACT_PHONE":"+49 89200045590","FACILITY_PRIVATE_PARKING":"true","FACILITY_CAFETERIA":"false","FACILITY_DISABLED_ACCESS":"true","FACILITY_PLAYPARK":"true","FACILITY_RESTAURANT":"false","FACILITY_WIFI":"false","FACILITY_CHANGEROOM":"true","FACILITY_VENDING_MACHINE":"true","FACILITY_FREE_PARKING":"true"},"resources":[{"resourceId":"b2d8552d-5794-4abc-879f-61d53f587978","name":"Court 1 (Indoor)","sport":"PADEL","features":["indoor","